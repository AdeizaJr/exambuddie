{
  "name": "exambuddie",
  "version": "1.0.0",
  "description": "AI-powered exam prep chatbot for Nigerian students",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/src/index.js",
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' nodemon --exec ts-node src/index.ts",
    "seed": "ts-node scripts/seed.ts",
    "generate-explanations": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node scripts/generateExplanations.ts",
    "import-explanations": "ts-node scripts/importExplanations.ts",
    "generate-explanations-to-json": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node scripts/generateExplanationsToJson.ts",
    "generate-explanations-cli": "ts-node scripts/generateExplanationsCLI.ts",
    "migrate": "ts-node scripts/migrate.ts",
    "mark-underlined": "ts-node scripts/markUnderlinedWords.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@types/cheerio": "^0.22.35",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "node": "^22.22.3",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "telegraf": "^4.16.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "wordpos": "^2.1.0"
  }
}
