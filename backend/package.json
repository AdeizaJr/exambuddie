{
  "name": "exambuddie",
  "version": "1.0.0",
  "description": "AI-powered exam prep chatbot for Nigerian students",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "overrides": {
    "node-cron": {
      "uuid": "^14.0.1"
    },
    "qs": "^6.16.0"
  },
  "scripts": {
    "build": "tsc",
    "build:miniapp": "cd ../miniapp && npm run build && rm -rf ../backend/dist/miniapp && cp -r dist ../backend/dist/miniapp",
    "build:all": "npm run build:miniapp && npm run build",
    "prestart": "ts-node scripts/migrate.ts && ts-node scripts/importDidYouKnow.ts",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/src/index.js",
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' nodemon --exec ts-node src/index.ts",
    "seed": "ts-node scripts/seed.ts",
    "generate-explanations": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node scripts/generateExplanations.ts",
    "import-explanations": "ts-node scripts/importExplanations.ts",
    "generate-explanations-to-json": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node scripts/generateExplanationsToJson.ts",
    "generate-explanations-cli": "ts-node scripts/generateExplanationsCLI.ts",
    "migrate": "ts-node scripts/migrate.ts",
    "format-explanations": "ts-node scripts/format-explanations.ts",
    "mark-underlined": "ts-node scripts/markUnderlinedWords.ts",
    "generate-daily-flyer": "ts-node scripts/generateDailyFlyer.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@types/cheerio": "^0.22.35",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.12",
    "opentype.js": "^2.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "sharp": "^0.35.4",
    "telegraf": "^4.16.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
