# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/exambuddie

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Flutterwave ───────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=https://your-app-url.com

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=your_admin_secret_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (admin-ui, miniapp deployment URLs)
ALLOWED_ORIGINS=https://admin.yourdomain.com,https://miniapp.yourdomain.com

# ── Pricing ───────────────────────────────────────────────────────────────────
MONTHLY_PRICE_NGN=800
YEARLY_PRICE_NGN=7000
FREE_DAILY_LIMIT=5
