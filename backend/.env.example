# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/exambuddie

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=https://your-app-url.com

# ── Admin ─────────────────────────────────────────────────────────────────────
# Seed credentials: used once on first boot to create the admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT signing secret — use a long random string in production
JWT_SECRET=your-long-random-jwt-secret-here
JWT_EXPIRES_IN=8h

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (admin-ui, miniapp deployment URLs)
ALLOWED_ORIGINS=https://admin.yourdomain.com,https://miniapp.yourdomain.com

# ── Pricing ───────────────────────────────────────────────────────────────────
# Pricing and free-tier daily limit are now stored in the `settings` DB table and
# editable from the admin dashboard (Pricing page). Seeded defaults are set by
# the migration in scripts/migrate.ts — no env vars needed here.
